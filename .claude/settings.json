{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/check-html.js",
            "statusMessage": "Syntax-checking index.html…"
          }
        ]
      }
    ]
  }
}
